{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vite.web.config.ts",
    "build-tools/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "tests/**/*"
  ]
}
